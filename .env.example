# Database (defaults to SQLite if not set)
DATABASE_URL=sqlite:///./fiagro.db
# For PostgreSQL: postgresql://user:password@localhost:5432/fiagro

# News API key (optional — Google News RSS is used as fallback)
NEWS_API_KEY=

# Scheduler (set to false to disable auto-updates)
SCHEDULER_ENABLED=true
SCHEDULER_HOUR=7
SCHEDULER_MINUTE=0
